                    "<div style='font-size:16px; color:var(--text-muted);'>Atualizado agora</div>" &
                "</div>" &
                "<div style='width:48px; height:48px; border-radius:14px; background:linear-gradient(135deg, var(--accent), #b48530); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:800; font-size:20px; box-shadow: 0 10px 20px var(--accent-glow);'>GS</div>" &
