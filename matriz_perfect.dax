VAR _dadosRetificadosMain = 
    CONCATENATEX(
        _datas_produtos,
        VAR _d = [AnoMes]
        VAR _p = [FiltroProduto]
        VAR _anoSelecionado = VALUE(LEFT(_d, 4))
        VAR _mesSelecionado = VALUE(RIGHT(_d, 2))
        VAR _dataUltimoDiaMes = EOMONTH(DATE(_anoSelecionado, _mesSelecionado, 1), 0)
        VAR _isCurrentMonth = IF(_anoSelecionado = YEAR(TODAY()) && _mesSelecionado = MONTH(TODAY()), TRUE(), FALSE())
        VAR _dataFinal = IF(_isCurrentMonth, TODAY(), _dataUltimoDiaMes)
        VAR _dataInicial = _dataFinal - 60

        VAR _vSul = CALCULATE(SUMX(vw_powerbi_regionais_hono_restituicao, vw_powerbi_regionais_hono_restituicao[VALOR_FINAL] + 0), vw_powerbi_regionais_hono_restituicao[REGIONAL_DEFAULT] = 1, FORMAT(vw_powerbi_regionais_hono_restituicao[DATA], "yyyy-MM") = _d, vw_powerbi_regionais_hono_restituicao[PRODUTO] = _p) + 0
        VAR _vSP = CALCULATE(SUMX(vw_powerbi_regionais_hono_restituicao, vw_powerbi_regionais_hono_restituicao[VALOR_FINAL] + 0), vw_powerbi_regionais_hono_restituicao[REGIONAL_DEFAULT] = 2, FORMAT(vw_powerbi_regionais_hono_restituicao[DATA], "yyyy-MM") = _d, vw_powerbi_regionais_hono_restituicao[PRODUTO] = _p) + 0
        VAR _vSudeste = CALCULATE(SUMX(vw_powerbi_regionais_hono_restituicao, vw_powerbi_regionais_hono_restituicao[VALOR_FINAL] + 0), vw_powerbi_regionais_hono_restituicao[REGIONAL_DEFAULT] = 3, FORMAT(vw_powerbi_regionais_hono_restituicao[DATA], "yyyy-MM") = _d, vw_powerbi_regionais_hono_restituicao[PRODUTO] = _p) + 0
        VAR _vNNCO = CALCULATE(SUMX(vw_powerbi_regionais_hono_restituicao, vw_powerbi_regionais_hono_restituicao[VALOR_FINAL] + 0), vw_powerbi_regionais_hono_restituicao[REGIONAL_DEFAULT] = 14, FORMAT(vw_powerbi_regionais_hono_restituicao[DATA], "yyyy-MM") = _d, vw_powerbi_regionais_hono_restituicao[PRODUTO] = _p) + 0
        VAR _somaDia = _vSul + _vSP + _vSudeste + _vNNCO
        RETURN IF(_somaDia > 0,
            "<span class='dado-retif-main' data-regional='Regional Sul' data-valor='" & FORMAT(_vSul, "0.00") & "' data-data='" & _d & "' data-produto='" & _p & "'></span>" &
            "<span class='dado-retif-main' data-regional='Regional Sudeste' data-valor='" & FORMAT(_vSP, "0.00") & "' data-data='" & _d & "' data-produto='" & _p & "'></span>" &
            "<span class='dado-retif-main' data-regional='Regional Sudeste 2' data-valor='" & FORMAT(_vSudeste, "0.00") & "' data-data='" & _d & "' data-produto='" & _p & "'></span>" &
            "<span class='dado-retif-main' data-regional='Regional NNCO' data-valor='" & FORMAT(_vNNCO, "0.00") & "' data-data='" & _d & "' data-produto='" & _p & "'></span>",
            ""
        ),
        ""
    )


VAR _dadosReunioes = 
    CONCATENATEX(
        _datas_meses,
        VAR _d = [AnoMes]
        VAR _DiasReais = DISTINCT(SELECTCOLUMNS(FILTER(vw_powerbi_agendas_rt, FORMAT(vw_powerbi_agendas_rt[DATA], "yyyy-MM") = _d), "DataDia", FORMAT(vw_powerbi_agendas_rt[DATA], "yyyy-MM-dd")))
        VAR _vSul = SUMX(
            _DiasReais,
            VAR _dia = [DataDia]
            RETURN CALCULATE(DISTINCTCOUNT(vw_powerbi_agendas_rt[CLIENTE]), vw_powerbi_agendas_rt[REGIONAL] = 1, FORMAT(vw_powerbi_agendas_rt[DATA], "yyyy-MM-dd") = _dia)
        ) + 0
        VAR _vSP = SUMX(
            _DiasReais,
            VAR _dia = [DataDia]
            RETURN CALCULATE(DISTINCTCOUNT(vw_powerbi_agendas_rt[CLIENTE]), vw_powerbi_agendas_rt[REGIONAL] = 2, FORMAT(vw_powerbi_agendas_rt[DATA], "yyyy-MM-dd") = _dia)
        ) + 0
        VAR _vSudeste = SUMX(
            _DiasReais,
            VAR _dia = [DataDia]
            RETURN CALCULATE(DISTINCTCOUNT(vw_powerbi_agendas_rt[CLIENTE]), vw_powerbi_agendas_rt[REGIONAL] = 3, FORMAT(vw_powerbi_agendas_rt[DATA], "yyyy-MM-dd") = _dia)
        ) + 0
        VAR _vNNCO = SUMX(
            _DiasReais,
            VAR _dia = [DataDia]
            RETURN CALCULATE(DISTINCTCOUNT(vw_powerbi_agendas_rt[CLIENTE]), vw_powerbi_agendas_rt[REGIONAL] = 14, FORMAT(vw_powerbi_agendas_rt[DATA], "yyyy-MM-dd") = _dia)
        ) + 0
        VAR _somaDia = _vSul + _vSP + _vSudeste + _vNNCO
        RETURN IF(_somaDia > 0,
            "<span class='dado-reuniao' data-regional='Regional Sul' data-valor='" & _vSul & "' data-data='" & _d & "'></span>" &
            "<span class='dado-reuniao' data-regional='Regional Sudeste' data-valor='" & _vSP & "' data-data='" & _d & "'></span>" &
            "<span class='dado-reuniao' data-regional='Regional Sudeste 2' data-valor='" & _vSudeste & "' data-data='" & _d & "'></span>" &
            "<span class='dado-reuniao' data-regional='Regional NNCO' data-valor='" & _vNNCO & "' data-data='" & _d & "'></span>",
            ""
        ),
        ""
    )

