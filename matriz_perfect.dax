                "<div class='card-value' id='card-perdidos'>R$ 0,00</div>" &
                "<div><span class='card-indicator ind-down'>&#8595; 0%</span> <span style='font-size:11px;color:var(--text-muted);'>vs mês ant.</span></div>" &
