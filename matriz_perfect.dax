                    "<button class='dropdown-btn' onclick='toggleProdDropdown()'><span id='prodBtnText'>TODOS PRODUTOS</span> <span style='font-size:16px; margin-left:4px;'>&#9660;</span></button>" &
                    "<div class='dropdown-menu' id='prodMenu'>" &
