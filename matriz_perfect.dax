                "<button class='btn-kpi-detalhar'>DETALHAR</button>" &
            "</div>" &
        "</div>" &
        "<div class='table-wrapper'>" &
            "<table class='tabela'>" &
                "<thead>" &
                    "<tr>" &
                        "<th>Ranking das Regionais</th>" &
                        "<th id='th-sul' data-reg='sul'><div style='display:inline-flex; align-items:center; gap:12px;'><img src='https://1drv.ms/i/c/434db18effbef75d/IQRKadnAcVfsQ5yvivcKPVZWASjm_xQT78xvHnH7DwNVyTs?width=766&height=750' style='width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid var(--accent); box-shadow: 0 6px 15px rgba(0,0,0,0.4);'><div style='display:flex; flex-direction:column; align-items:flex-start; gap:4px;'><div style='display:flex; align-items:center; gap:6px;'><span id='badge-sul' style='background:rgba(255,255,255,0.1); padding:2px 6px; border-radius:4px; font-size:14px; font-weight:700;'>-º</span><span style='font-size:15px; font-weight:700; text-transform:uppercase; letter-spacing:1px;'>Sul</span></div><div id='pts-sul' style='font-size:12px; color:var(--text-sec); font-weight:500; text-transform:uppercase; letter-spacing:1px;'>R$ 0,00</div></div></div></th>" &
                        "<th id='th-sp' data-reg='sp'><div style='display:inline-flex; align-items:center; gap:12px;'><img src='https://1drv.ms/i/c/434db18effbef75d/IQQ4YkrhK6wQSrHc3RbIOqVVAUZKDYXFWQ0B28zx3MX8v9E?width=1024&height=1016' style='width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid var(--accent); box-shadow: 0 6px 15px rgba(0,0,0,0.4);'><div style='display:flex; flex-direction:column; align-items:flex-start; gap:4px;'><div style='display:flex; align-items:center; gap:6px;'><span id='badge-sp' style='background:rgba(255,255,255,0.1); padding:2px 6px; border-radius:4px; font-size:14px; font-weight:700;'>-º</span><span style='font-size:15px; font-weight:700; text-transform:uppercase; letter-spacing:1px;'>Sudeste</span></div><div id='pts-sp' style='font-size:12px; color:var(--text-sec); font-weight:500; text-transform:uppercase; letter-spacing:1px;'>R$ 0,00</div></div></div></th>" &
                        "<th id='th-sd' data-reg='sd'><div style='display:inline-flex; align-items:center; gap:12px;'><img src='https://1drv.ms/i/c/434db18effbef75d/IQQlL7rXeQ9JRY6Ro7TpyUh1ARJ00PqB1-Z0X_ZgqALnV3U' style='width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid var(--accent); box-shadow: 0 6px 15px rgba(0,0,0,0.4);'><div style='display:flex; flex-direction:column; align-items:flex-start; gap:4px;'><div style='display:flex; align-items:center; gap:6px;'><span id='badge-sd' style='background:rgba(255,255,255,0.1); padding:2px 6px; border-radius:4px; font-size:14px; font-weight:700;'>-º</span><span style='font-size:15px; font-weight:700; text-transform:uppercase; letter-spacing:1px;'>Sudeste 2</span></div><div id='pts-sd' style='font-size:12px; color:var(--text-sec); font-weight:500; text-transform:uppercase; letter-spacing:1px;'>R$ 0,00</div></div></div></th>" &
                        "<th id='th-nn' data-reg='nn'><div style='display:inline-flex; align-items:center; gap:12px;'><img src='https://1drv.ms/i/c/434db18effbef75d/IQTo81BJwgdNQaWcwS-06qprATiDsMRnekZrdrv_bVbYx_4?width=1600&height=1066' style='width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid var(--accent); box-shadow: 0 6px 15px rgba(0,0,0,0.4);'><div style='display:flex; flex-direction:column; align-items:flex-start; gap:4px;'><div style='display:flex; align-items:center; gap:6px;'><span id='badge-nn' style='background:rgba(255,255,255,0.1); padding:2px 6px; border-radius:4px; font-size:14px; font-weight:700;'>-º</span><span style='font-size:15px; font-weight:700; text-transform:uppercase; letter-spacing:1px;'>NNCO</span></div><div id='pts-nn' style='font-size:12px; color:var(--text-sec); font-weight:500; text-transform:uppercase; letter-spacing:1px;'>R$ 0,00</div></div></div></th>" &
                        "<th><div style='display:inline-flex; align-items:center; gap:12px;'><img src='data:image/jpeg;base64,' style='width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid var(--accent); box-shadow: 0 6px 15px rgba(0,0,0,0.4);'><span style='font-size:15px; font-weight:700; text-transform:uppercase; letter-spacing:1.5px; color:var(--text-sec);'>Total Geral</span></div></th>" &
                    "</tr>" &
                "</thead>" &
                "<tbody>" &
                    _linha0 & _linha1 & _linha_apneg & _linha_apneg_detalhes & _linha2 & _linha2_detalhes & _linha_nao_aprovados & _linha3 & _linha3_nao_aprovados & _linha5 &
                "</tbody>" &
            "</table>" &
        "</div>" &
    "</div>" &
    "<div style='display:none;' id='dados-enc-container'>" & _dadosEncontrados & "</div>" &
    "<div style='display:none;' id='dados-cred-sem-container'>" & _dadosCreditoSemHon & "</div>" &
    "<div style='display:none;' id='dados-apres-container'>" & _dadosApresentados & "</div>" &
    "<div style='display:none;' id='dados-perdidos-container'>" & _dadosPerdidos & "</div>" &
    "<div style='display:none;' id='dados-nao-aprovados-real-container'>" & _dadosNaoAprovadosReal & "</div>" &
    "<div style='display:none;' id='dados-aprov-container'>" & _dadosAprovados & "</div>" &
    "<div style='display:none;' id='dados-apneg-total-container'>" & _dadosAprovNegocTotal & "</div>" &
    "<div style='display:none;' id='dados-apneg-iniciais-container'>" & _dadosAprovNegocIniciais & "</div>" &
    "<div style='display:none;' id='dados-apneg-comp-container'>" & _dadosAprovNegocComp & "</div>" &
    "<div style='display:none;' id='dados-apneg-rest-container'>" & _dadosAprovNegocRest & "</div>" &
    "<div style='display:none;' id='dados-apneg-ajuiz-container'>" & _dadosAprovNegocAjuiz & "</div>" &
    "<div style='display:none;' id='dados-aprov-total-container'>" & _dadosAprovadosTotal & "</div>" &
    "<div style='display:none;' id='dados-comp-container'>" & _dadosCompensacao & "</div>" &
    "<div style='display:none;' id='dados-retif-container'>" & _dadosRetificacao & "</div>" &
    "<div style='display:none;' id='dados-ajuiz-container'>" & _dadosAjuizamento & "</div>" &
    "<div style='display:none;' id='dados-caixa-container'>" & _dadosCaixa & "</div>" &
    "<div style='display:none;' id='dados-restituicao-container'>" & _dadosRetificadosMain & "</div>" &
    "<div style='display:none;' id='dados-nao-aprov-container'>" & _dadosNaoAprovados & "</div>" &
    "<div style='display:none;' id='dados-reuniao-container'>" & _dadosReunioes & "</div>" &
    "<script>" &
    "function toggleMesDropdown() {" &
          "var menu = document.getElementById('mesMenu');" &
          "menu.classList.toggle('show');" &
      "}" &
      "function toggleAllMeses(source) {" &
          "var checkboxes = document.querySelectorAll('.mes-checkbox');" &
          "for(var i=0; i<checkboxes.length; i++) { checkboxes[i].checked = source.checked; }" &
          "atualizarMesBtnText();" &
      "}" &
      "function atualizarMesBtnText() {" &
          "var checkboxes = document.querySelectorAll('.mes-checkbox');" &
          "var checkedBoxes = document.querySelectorAll('.mes-checkbox:checked');" &
          "var btnText = 'TODOS (MÊS)';" &
          "if(checkedBoxes.length === 0) btnText = 'NENHUM MÊS';" &
          "else if(checkedBoxes.length < checkboxes.length) btnText = checkedBoxes.length + ' MESES';" &
          "document.getElementById('mesBtnText').innerText = btnText;" &
          "var allCb = document.getElementById('selectAllMeses');" &
          "if(allCb) allCb.checked = (checkedBoxes.length === checkboxes.length);" &
      "}" &

      "window.rtRuleActive = true;" &
      "function clickToggleRT() {" &
          "window.rtRuleActive = !window.rtRuleActive;" &
          "var thumb = document.getElementById('sliderThumb');" &
          "var bg = document.getElementById('sliderBg');" &
          "if(window.rtRuleActive) { thumb.style.transform = 'translateX(20px)'; thumb.style.backgroundColor = '#fff'; bg.style.backgroundColor = 'var(--orange)'; }" &
          "else { thumb.style.transform = 'translateX(0px)'; thumb.style.backgroundColor = 'var(--orange)'; bg.style.backgroundColor = 'transparent'; }" &
          "filtrarTudo();" &
      "}" &
      "function toggleProdDropdown() {" &
        "var menu = document.getElementById('prodMenu');" &
        "menu.classList.toggle('show');" &
        "if(menu.classList.contains('show')) { document.getElementById('prodSearch').focus(); }" &
    "}" &
    "function filtrarProdMenu() {" &
        "var filter = document.getElementById('prodSearch').value.toUpperCase();" &
        "var items = document.querySelectorAll('.dropdown-item');" &
        "for(var i=0; i<items.length; i++) {" &
            "var text = items[i].innerText.toUpperCase();" &
            "if(text.indexOf(filter) > -1) { items[i].style.display = ''; } else { items[i].style.display = 'none'; }" &
        "}" &
    "}" &
    "function selecionarProduto(el, valor) {" &
        "document.getElementById('global-produto').value = valor;" &
        "var btnText = valor === '' ? 'TODOS PRODUTOS' : valor;" &
        "document.getElementById('prodBtnText').innerText = btnText;" &
        "var items = document.querySelectorAll('.dropdown-item');" &
        "for(var i=0; i<items.length; i++) { items[i].classList.remove('selected'); }" &
        "el.classList.add('selected');" &
        "document.getElementById('prodMenu').classList.remove('show');" &
        "filtrarTudo();" &
    "}" &
    "document.addEventListener('click', function(e) {" &
        "if (!e.target.closest('.dropdown-container')) {
              var mesMenu = document.getElementById('mesMenu');
              if (mesMenu && mesMenu.classList.contains('show')) { mesMenu.classList.remove('show'); }" &
            "var menu = document.getElementById('prodMenu');" &
            "if (menu && menu.classList.contains('show')) { menu.classList.remove('show'); }" &
        "}" &
    "});" &
    "function formatarMoeda(valor) {" &
        "return 'R$ ' + valor.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });" &
    "}" &
    "function formatarMilhoes(valor) {" &
        "if(valor === 0) return 'R$ 0,00';" &
        "if(valor < 1000000) return formatarMoeda(valor);" &
        "if(valor < 1000000000) return 'R$ ' + (valor / 1000000).toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' M';" &
        "if(valor < 1000000000000) return 'R$ ' + (valor / 1000000000).toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' Bi';" &
        "return 'R$ ' + (valor / 1000000000000).toLocaleString('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + ' Tri';" &
    "}" &
    "function calcularSoma(classe) {" &
          "var spans = document.getElementsByClassName(classe);" &
          "var soma = { 'Regional Sul': 0, 'Regional Sudeste': 0, 'Regional Sudeste 2': 0, 'Regional NNCO': 0, 'Total': 0 };" &
          "var prodBox = document.getElementById('global-produto');" &
          "var prod = prodBox ? prodBox.value : '';" &
          "var regraAtiva = typeof window.rtRuleActive !== 'undefined' ? window.rtRuleActive : true;" &
          "var checkedBoxes = document.querySelectorAll('.mes-checkbox:checked');" &
          "var selectedMeses = {};" &
          "for(var k=0; k<checkedBoxes.length; k++) { selectedMeses[checkedBoxes[k].value] = true; }" &
          "for(var i=0; i<spans.length; i++) {" &
              "var d = spans[i].getAttribute('data-data');" &
              "var pass = true;" &
              "if(!selectedMeses[d]) pass = false;" &
              "var p = spans[i].getAttribute('data-produto');" &
              "if(classe !== 'dado-caixa' && classe !== 'dado-reuniao' && prod !== '' && p !== prod) pass = false;" &
              "if(pass) {" &
                  "var vStr = '0';" &
                  "if(regraAtiva && spans[i].hasAttribute('data-valor')) vStr = spans[i].getAttribute('data-valor');" &
                  "else if(!regraAtiva && spans[i].hasAttribute('data-valor-sr')) vStr = spans[i].getAttribute('data-valor-sr');" &
                  "else vStr = spans[i].getAttribute('data-valor') || '0';" &
                  "var v = parseFloat(vStr.replace(',', '.')) || 0;" &
                  "var r = spans[i].getAttribute('data-regional');" &
                  "if(soma[r] !== undefined) { soma[r] += v; }" &
                  "soma['Total'] += v;" &
              "}" &
          "}" &
          "return soma;" &
      "}" &
      "function filtrarTudo() {" &
        "/* CALCULAR CAIXA */" &
        "var sCx = calcularSoma('dado-caixa');" &
        			        			        			        			        			        			        "/* CALCULAR CREDITO SEM HON */" &
        "var sCredSem = calcularSoma('dado-cred-sem');" &
        "document.getElementById('card-credito-sem-hon').innerText = formatarMilhoes(sCredSem['Total']);" &
        "/* CALCULAR ENCONTRADOS */" &
        "var sEn = calcularSoma('dado-enc');" &
        "document.getElementById('enc-sul').innerText = formatarMoeda(sEn['Regional Sul']);" &
        "document.getElementById('enc-sp').innerText = formatarMoeda(sEn['Regional Sudeste']);" &
        "document.getElementById('enc-sd').innerText = formatarMoeda(sEn['Regional Sudeste 2']);" &
        "document.getElementById('enc-nn').innerText = formatarMoeda(sEn['Regional NNCO']);" &
        "document.getElementById('enc-total').innerText = formatarMoeda(sEn['Total']);" &
        "document.getElementById('card-encontrados').innerText = formatarMilhoes(sEn['Total']);" &
        
        "/* CALCULAR NÃO APROVADOS */" &
        "var sNAprov = calcularSoma('dado-nao-aprov');" &
        "document.getElementById('naprov-sul').innerText = formatarMoeda(sNAprov['Regional Sul']);" &
        "document.getElementById('naprov-sp').innerText = formatarMoeda(sNAprov['Regional Sudeste']);" &
        "document.getElementById('naprov-sd').innerText = formatarMoeda(sNAprov['Regional Sudeste 2']);" &
        "document.getElementById('naprov-nn').innerText = formatarMoeda(sNAprov['Regional NNCO']);" &
        "document.getElementById('naprov-total').innerText = formatarMoeda(sNAprov['Total']);" &
        "document.getElementById('card-nao-aprovados').innerText = formatarMilhoes(sNAprov['Total']);" &
        "        /* CALCULAR APROVADOS EM NEGOCIAÇÃO */
        var sApNegTotal = calcularSoma('dado-apneg-total');
        var sApNegIniciais = calcularSoma('dado-apneg-iniciais');
        var sApNegComp = calcularSoma('dado-apneg-comp');
        var sApNegRest = calcularSoma('dado-apneg-rest');
        var sApNegAjuiz = calcularSoma('dado-apneg-ajuiz');

        var elCardApNeg = document.getElementById('card-aprov-negoc');
        if(elCardApNeg) elCardApNeg.innerText = formatarMilhoes(sApNegTotal['Total']);

        var elApnSul = document.getElementById('apneg-sul'); if(elApnSul) elApnSul.innerText = formatarMoeda(sApNegTotal['Regional Sul']);
        var elApnSP = document.getElementById('apneg-sp'); if(elApnSP) elApnSP.innerText = formatarMoeda(sApNegTotal['Regional Sudeste']);
        var elApnSD = document.getElementById('apneg-sd'); if(elApnSD) elApnSD.innerText = formatarMoeda(sApNegTotal['Regional Sudeste 2']);
        var elApnNN = document.getElementById('apneg-nn'); if(elApnNN) elApnNN.innerText = formatarMoeda(sApNegTotal['Regional NNCO']);
        var elApnTot = document.getElementById('apneg-total'); if(elApnTot) elApnTot.innerText = formatarMoeda(sApNegTotal['Total']);

        var elApnHiSul = document.getElementById('apneg-hi-sul'); if(elApnHiSul) elApnHiSul.innerText = formatarMoeda(sApNegIniciais['Regional Sul']);
        var elApnHiSP = document.getElementById('apneg-hi-sp'); if(elApnHiSP) elApnHiSP.innerText = formatarMoeda(sApNegIniciais['Regional Sudeste']);
        var elApnHiSD = document.getElementById('apneg-hi-sd'); if(elApnHiSD) elApnHiSD.innerText = formatarMoeda(sApNegIniciais['Regional Sudeste 2']);
        var elApnHiNN = document.getElementById('apneg-hi-nn'); if(elApnHiNN) elApnHiNN.innerText = formatarMoeda(sApNegIniciais['Regional NNCO']);
        var elApnHiTot = document.getElementById('apneg-hi-total'); if(elApnHiTot) elApnHiTot.innerText = formatarMoeda(sApNegIniciais['Total']);

        var elApnHcSul = document.getElementById('apneg-hc-sul'); if(elApnHcSul) elApnHcSul.innerText = formatarMoeda(sApNegComp['Regional Sul']);
        var elApnHcSP = document.getElementById('apneg-hc-sp'); if(elApnHcSP) elApnHcSP.innerText = formatarMoeda(sApNegComp['Regional Sudeste']);
        var elApnHcSD = document.getElementById('apneg-hc-sd'); if(elApnHcSD) elApnHcSD.innerText = formatarMoeda(sApNegComp['Regional Sudeste 2']);
        var elApnHcNN = document.getElementById('apneg-hc-nn'); if(elApnHcNN) elApnHcNN.innerText = formatarMoeda(sApNegComp['Regional NNCO']);
        var elApnHcTot = document.getElementById('apneg-hc-total'); if(elApnHcTot) elApnHcTot.innerText = formatarMoeda(sApNegComp['Total']);

        var elApnHrSul = document.getElementById('apneg-hr-sul'); if(elApnHrSul) elApnHrSul.innerText = formatarMoeda(sApNegRest['Regional Sul']);
        var elApnHrSP = document.getElementById('apneg-hr-sp'); if(elApnHrSP) elApnHrSP.innerText = formatarMoeda(sApNegRest['Regional Sudeste']);
        var elApnHrSD = document.getElementById('apneg-hr-sd'); if(elApnHrSD) elApnHrSD.innerText = formatarMoeda(sApNegRest['Regional Sudeste 2']);
        var elApnHrNN = document.getElementById('apneg-hr-nn'); if(elApnHrNN) elApnHrNN.innerText = formatarMoeda(sApNegRest['Regional NNCO']);
        var elApnHrTot = document.getElementById('apneg-hr-total'); if(elApnHrTot) elApnHrTot.innerText = formatarMoeda(sApNegRest['Total']);

        var elApnHaSul = document.getElementById('apneg-ha-sul'); if(elApnHaSul) elApnHaSul.innerText = formatarMoeda(sApNegAjuiz['Regional Sul']);
        var elApnHaSP = document.getElementById('apneg-ha-sp'); if(elApnHaSP) elApnHaSP.innerText = formatarMoeda(sApNegAjuiz['Regional Sudeste']);
        var elApnHaSD = document.getElementById('apneg-ha-sd'); if(elApnHaSD) elApnHaSD.innerText = formatarMoeda(sApNegAjuiz['Regional Sudeste 2']);
        var elApnHaNN = document.getElementById('apneg-ha-nn'); if(elApnHaNN) elApnHaNN.innerText = formatarMoeda(sApNegAjuiz['Regional NNCO']);
        var elApnHaTot = document.getElementById('apneg-ha-total'); if(elApnHaTot) elApnHaTot.innerText = formatarMoeda(sApNegAjuiz['Total']);

        /* CALCULAR APROVADOS (INICIAIS + COMP + RETIF + AJUIZ) */" &
        "var sApTotal = calcularSoma('dado-aprov-total');" &
        "var sAp = calcularSoma('dado-aprov');" &
        "var sComp = calcularSoma('dado-comp');" &
        "var sRetif = calcularSoma('dado-retif');" &
        "var sAjuiz = calcularSoma('dado-ajuiz');" &
        "var tSul = sApTotal['Regional Sul'];" &
        "var tSP = sApTotal['Regional Sudeste'];" &
        "var tSD = sApTotal['Regional Sudeste 2'];" &
        "var tNN = sApTotal['Regional NNCO'];" &
        "var tGeral = sApTotal['Total'];" &
        "document.getElementById('ap-sul').innerText = formatarMoeda(tSul);" &
        "document.getElementById('ap-sp').innerText = formatarMoeda(tSP);" &
        "document.getElementById('ap-sd').innerText = formatarMoeda(tSD);" &
        "document.getElementById('ap-nn').innerText = formatarMoeda(tNN);" &
        "document.getElementById('ap-total').innerText = formatarMoeda(tGeral);" &
        "document.getElementById('card-aprov').innerText = formatarMilhoes(tGeral);" &
        
        "        /* CALCULAR RANKING POR TOTAL DE HONORÁRIOS APROVADOS */
        var ranks = [
            { id: 'sul', val: tSul },
            { id: 'sp', val: tSP },
            { id: 'sd', val: tSD },
            { id: 'nn', val: tNN }
        ];
        ranks.sort(function(a, b) { return b.val - a.val; });
        
        for(var i=0; i<ranks.length; i++){
            var r = ranks[i];
            var elBadge = document.getElementById('badge-' + r.id);
            var elPts = document.getElementById('pts-' + r.id);
            if(elBadge) elBadge.innerText = (i+1) + 'º';
            if(elPts) elPts.innerText = formatarMilhoes(r.val);
        }

        var table = document.querySelector('.tabela');" &
        "if(table) {" &
            "var trs = table.querySelectorAll('tr');" &
            "for(var i=0; i<trs.length; i++){" &
                "var tr = trs[i];" &
                "if(tr.querySelector('td[colspan]')) continue;" &
                "var totalCell = tr.lastElementChild;" &
                "for(var j=0; j<ranks.length; j++){" &
                    "var rId = ranks[j].id;" &
                    "for(var k=0; k<tr.children.length; k++){" &
                        "var child = tr.children[k];" &
                        "if(child.id && child.id.endsWith('-' + rId)){" &
                            "tr.insertBefore(child, totalCell);" &
                            "break;" &
                        "}" &
                    "}" &
                "}" &
            "}" &
        "}" &

        "/* ESPELHAR NO DETALHAMENTO DOS APROVADOS */" &
        "document.getElementById('hi-sul').innerText = formatarMoeda(sAp['Regional Sul']);" &
        "document.getElementById('hi-sp').innerText = formatarMoeda(sAp['Regional Sudeste']);" &
        "document.getElementById('hi-sd').innerText = formatarMoeda(sAp['Regional Sudeste 2']);" &
        "document.getElementById('hi-nn').innerText = formatarMoeda(sAp['Regional NNCO']);" &
        "document.getElementById('hi-total').innerText = formatarMoeda(sAp['Total']);" &
        "document.getElementById('hc-sul').innerText = formatarMoeda(sComp['Regional Sul']);" &
        "document.getElementById('hc-sp').innerText = formatarMoeda(sComp['Regional Sudeste']);" &
        "document.getElementById('hc-sd').innerText = formatarMoeda(sComp['Regional Sudeste 2']);" &
        "document.getElementById('hc-nn').innerText = formatarMoeda(sComp['Regional NNCO']);" &
        "document.getElementById('hc-total').innerText = formatarMoeda(sComp['Total']);" &
        "document.getElementById('hr-sul').innerText = formatarMoeda(sRetif['Regional Sul']);" &
        "document.getElementById('hr-sp').innerText = formatarMoeda(sRetif['Regional Sudeste']);" &
        "document.getElementById('hr-sd').innerText = formatarMoeda(sRetif['Regional Sudeste 2']);" &
        "document.getElementById('hr-nn').innerText = formatarMoeda(sRetif['Regional NNCO']);" &
        "document.getElementById('hr-total').innerText = formatarMoeda(sRetif['Total']);" &
        "document.getElementById('ha-sul').innerText = formatarMoeda(sAjuiz['Regional Sul']);" &
        "document.getElementById('ha-sp').innerText = formatarMoeda(sAjuiz['Regional Sudeste']);" &
        "document.getElementById('ha-sd').innerText = formatarMoeda(sAjuiz['Regional Sudeste 2']);" &
        "document.getElementById('ha-nn').innerText = formatarMoeda(sAjuiz['Regional NNCO']);" &
        "document.getElementById('ha-total').innerText = formatarMoeda(sAjuiz['Total']);" &
        "/* CALCULAR APRESENTADOS */" &
        "var sApres = calcularSoma('dado-apres');" &
        "document.getElementById('apres-sul').innerText = formatarMoeda(sApres['Regional Sul']);" &
        "document.getElementById('apres-sp').innerText = formatarMoeda(sApres['Regional Sudeste']);" &
        "document.getElementById('apres-sd').innerText = formatarMoeda(sApres['Regional Sudeste 2']);" &
        "document.getElementById('apres-nn').innerText = formatarMoeda(sApres['Regional NNCO']);" &
        "document.getElementById('apres-total').innerText = formatarMoeda(sApres['Total']);" &
        "document.getElementById('card-apresentados').innerText = formatarMilhoes(sApres['Total']);" &
        "/* CALCULAR PERDIDOS */" &
        "var sPerd = calcularSoma('dado-perdidos');" &
        "document.getElementById('perdidos-sul').innerText = formatarMoeda(sPerd['Regional Sul']);" &
        "document.getElementById('perdidos-sp').innerText = formatarMoeda(sPerd['Regional Sudeste']);" &
        "document.getElementById('perdidos-sd').innerText = formatarMoeda(sPerd['Regional Sudeste 2']);" &
        "document.getElementById('perdidos-nn').innerText = formatarMoeda(sPerd['Regional NNCO']);" &
        "document.getElementById('perdidos-total').innerText = formatarMoeda(sPerd['Total']);" &

        "var sNaoAprovReal = calcularSoma('dado-nao-aprovados-real');" &
        "document.getElementById('nareal-sul').innerText = formatarMoeda(sNaoAprovReal['Regional Sul']);" &
        "document.getElementById('nareal-sp').innerText = formatarMoeda(sNaoAprovReal['Regional Sudeste']);" &
        "document.getElementById('nareal-sd').innerText = formatarMoeda(sNaoAprovReal['Regional Sudeste 2']);" &
        "document.getElementById('nareal-nn').innerText = formatarMoeda(sNaoAprovReal['Regional NNCO']);" &
        "document.getElementById('nareal-total').innerText = formatarMoeda(sNaoAprovReal['Total']);" &
        "var cardNAReal = document.getElementById('card-nao-aprovados-real'); if(cardNAReal) cardNAReal.innerText = formatarMilhoes(sNaoAprovReal['Total']);" &

        "document.getElementById('card-perdidos').innerText = formatarMilhoes(sPerd['Total']);" &
        "/* CALCULAR REUNIOES */" &
        "var sReu = calcularSoma('dado-reuniao');" &
        "document.getElementById('reuniao-sul').innerText = Math.round(sReu['Regional Sul']);" &
        "document.getElementById('reuniao-sp').innerText = Math.round(sReu['Regional Sudeste']);" &
        "document.getElementById('reuniao-sd').innerText = Math.round(sReu['Regional Sudeste 2']);" &
        "document.getElementById('reuniao-nn').innerText = Math.round(sReu['Regional NNCO']);" &
        "document.getElementById('reuniao-total').innerText = Math.round(sReu['Total']);" &

    "}" &
    "function toggleDetails(className) {" &
        "var rows = document.getElementsByClassName(className);" &
        "var icon = document.getElementById('icon-aprovados');" &
        "if(rows.length === 0) return;" &
        "var isHidden = rows[0].style.display === 'none';" &
        "for (var i = 0; i < rows.length; i++) {" &
            "rows[i].style.display = isHidden ? 'table-row' : 'none';" &
        "}" &
        "if(icon) { icon.innerHTML = isHidden ? '&#9660;' : '&#9654;'; }" &
    "}" &
    "setTimeout(function() { filtrarTudo(); }, 50);" &
    "</script>" &
    "</body></html>"
RETURN _html




