HTML_Onboarding_Executivo = 
VAR _MaxRows = 2000
VAR _TabelaBase = 
    TOPN(
        _MaxRows,
        SUMMARIZE(
            'vw_powerbi_empresas_Onboarding',
            'vw_powerbi_empresas_Onboarding'[JOB],
            'vw_powerbi_empresas_Onboarding'[EMPRESA],
            'vw_powerbi_empresas_Onboarding'[Grupo],
            'vw_powerbi_empresas_Onboarding'[CONSULTOR],
            'vw_powerbi_empresas_Onboarding'[UNIDADE],
            'vw_powerbi_empresas_Onboarding'[DATA_CADASTRO],
            'vw_powerbi_empresas_Onboarding'[CNPJ],
            'vw_powerbi_empresas_Onboarding'[PROCURACAO],
            'vw_powerbi_empresas_Onboarding'[ASSESSEMENT],
            'vw_powerbi_empresas_Onboarding'[CHECKLIST],
            'vw_powerbi_empresas_Onboarding'[STATUS_SLA_TEXTO]
        ),
        'vw_powerbi_empresas_Onboarding'[DATA_CADASTRO],
        DESC
    )

VAR _CSS = "
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; }
  body, html { width: 100%; height: 100%; background-color: #070B14; color: #E2E8F0; overflow: hidden; }
  
  .onboarding-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    padding: 16px;
    background: radial-gradient(circle at 50% 0%, #111A2E 0%, #070B14 100%);
    gap: 12px;
  }

  /* KPI Header */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
  }
  .kpi-card {
    background: rgba(18, 26, 44, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s, border-color 0.2s;
  }
  .kpi-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.3);
  }
  .kpi-info h4 {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #94A3B8;
  }
  .kpi-info .kpi-num {
    font-size: 20px;
    font-weight: 700;
    color: #FFFFFF;
    margin-top: 2px;
  }
  .kpi-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }
  .kpi-blue { background: rgba(56, 189, 248, 0.15); color: #38BDF8; }
  .kpi-green { background: rgba(16, 185, 129, 0.15); color: #10B981; }
  .kpi-amber { background: rgba(245, 158, 11, 0.15); color: #F59E0B; }
  .kpi-red { background: rgba(239, 68, 68, 0.15); color: #EF4444; }

  /* Controls Bar */
  .controls-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 14px;
    gap: 10px;
  }
  .search-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    max-width: 400px;
  }
  .global-search {
    width: 100%;
    background: #0B1120;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 7px 12px;
    font-size: 13px;
    color: #F8FAFC;
    outline: none;
    transition: all 0.2s;
  }
  .global-search:focus {
    border-color: #38BDF8;
    box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
  }
  .controls-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .btn-reset {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #CBD5E1;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-reset:hover {
    background: rgba(239, 68, 68, 0.15);
    color: #FCA5A5;
    border-color: rgba(239, 68, 68, 0.3);
  }
  .page-size-select {
    background: #0B1120;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #F8FAFC;
    padding: 6px 8px;
    border-radius: 6px;
    font-size: 12px;
    outline: none;
    cursor: pointer;
  }
  .counter-badge {
    font-size: 12px;
    color: #94A3B8;
  }
  .counter-badge span {
    font-weight: 700;
    color: #38BDF8;
  }

  /* Table Wrapper */
  .table-wrapper {
    flex: 1;
    overflow: auto;
    background: rgba(11, 17, 32, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
    box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
  }
  .table-wrapper::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .table-wrapper::-webkit-scrollbar-track {
    background: #070B14;
  }
  .table-wrapper::-webkit-scrollbar-thumb {
    background: #1E293B;
    border-radius: 4px;
  }
  .table-wrapper::-webkit-scrollbar-thumb:hover {
    background: #334155;
  }

  /* Table */
  table.exec-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 12px;
    text-align: left;
    white-space: nowrap;
  }
  table.exec-table th {
    position: sticky;
    top: 0;
    background: #0F172A;
    color: #94A3B8;
    padding: 8px 10px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid rgba(56, 189, 248, 0.3);
    z-index: 10;
  }
  .th-header-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .th-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
  }
  .th-title:hover {
    color: #38BDF8;
  }
  .th-search {
    width: 100%;
    background: #070B14;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 10px;
    color: #F1F5F9;
    outline: none;
    font-weight: normal;
    text-transform: none;
  }
  .th-search:focus {
    border-color: #38BDF8;
    background: #0B1120;
  }
  
  table.exec-table td {
    padding: 8px 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: #CBD5E1;
    vertical-align: middle;
  }
  table.exec-table tbody tr {
    transition: background 0.15s ease;
  }
  table.exec-table tbody tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.015);
  }
  table.exec-table tbody tr:hover {
    background: rgba(56, 189, 248, 0.07) !important;
  }

  /* Badges & Cell Styles */
  .badge-job {
    display: inline-block;
    padding: 3px 7px;
    border-radius: 5px;
    background: rgba(2, 132, 199, 0.2);
    color: #38BDF8;
    font-weight: 700;
    font-size: 11px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    letter-spacing: 0.3px;
  }
  .font-bold { font-weight: 600; color: #FFFFFF; }
  .font-mono { font-family: 'Consolas', 'Courier New', monospace; font-size: 11px; }
  .badge-pill {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 12px;
    background: rgba(148, 163, 184, 0.15);
    color: #94A3B8;
    font-weight: 600;
    font-size: 11px;
  }
  
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .b-green { background: rgba(16, 185, 129, 0.15); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.3); }
  .b-red { background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.3); }
  .b-blue { background: rgba(56, 189, 248, 0.15); color: #38BDF8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .b-gray { background: rgba(148, 163, 184, 0.1); color: #94A3B8; border: 1px solid rgba(148, 163, 184, 0.2); }
  .b-complete { background: linear-gradient(135deg, rgba(16,185,129,0.25) 0%, rgba(5,150,105,0.35) 100%); color: #6EE7B7; border: 1px solid #10B981; box-shadow: 0 0 8px rgba(16,185,129,0.2); }
  .b-progress { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.3); }
  .b-ontime { background: rgba(16, 185, 129, 0.2); color: #34D399; border: 1px solid #10B981; }
  .b-delayed { background: rgba(239, 68, 68, 0.2); color: #F87171; border: 1px solid #EF4444; }

  /* Pagination Bar */
  .pagination-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    font-size: 12px;
  }
  .pagination-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .pg-btn {
    background: #0B1120;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #F8FAFC;
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pg-btn:hover:not(:disabled) {
    background: #38BDF8;
    color: #070B14;
    border-color: #38BDF8;
  }
  .pg-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .pg-info {
    color: #94A3B8;
    font-size: 11px;
  }
</style>
"

VAR _HeaderHTML = "
<div class='onboarding-container'>
  <!-- KPI ROW -->
  <div class='kpi-row'>
    <div class='kpi-card'>
      <div class='kpi-info'>
        <h4>Total Jobs</h4>
        <div class='kpi-num' id='kpiTotal'>0</div>
      </div>
      <div class='kpi-icon kpi-blue'>📦</div>
    </div>
    <div class='kpi-card'>
      <div class='kpi-info'>
        <h4>100% Finalizados</h4>
        <div class='kpi-num' id='kpiComplete'>0</div>
      </div>
      <div class='kpi-icon kpi-green'>🎯</div>
    </div>
    <div class='kpi-card'>
      <div class='kpi-info'>
        <h4>Dentro do Prazo</h4>
        <div class='kpi-num' id='kpiOnTime'>0</div>
      </div>
      <div class='kpi-icon kpi-green'>⚡</div>
    </div>
    <div class='kpi-card'>
      <div class='kpi-info'>
        <h4>Atrasados</h4>
        <div class='kpi-num' id='kpiDelayed'>0</div>
      </div>
      <div class='kpi-icon kpi-red'>⚠️</div>
    </div>
  </div>

  <!-- CONTROLS BAR -->
  <div class='controls-bar'>
    <div class='search-group'>
      <input type='text' id='globalSearch' class='global-search' placeholder='🔍 Busca rápida em todas as colunas...' oninput='window.applyFilters()'>
    </div>
    <div class='controls-right'>
      <button class='btn-reset' onclick='window.resetFilters()'>Limpar Filtros</button>
      <select id='pageSizeSelect' class='page-size-select' onchange='window.changePageSize(this.value)'>
        <option value='15'>15 linhas</option>
        <option value='25' selected>25 linhas</option>
        <option value='50'>50 linhas</option>
        <option value='100'>100 linhas</option>
        <option value='-1'>Todas</option>
      </select>
      <div class='counter-badge'>Exibindo <span id='visibleCount'>0</span> de <span id='totalCount'>0</span></div>
    </div>
  </div>

  <!-- TABLE WRAPPER -->
  <div class='table-wrapper'>
    <table class='exec-table' id='onboardingTable'>
      <thead>
        <tr>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(0)'>JOB <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='0' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(1)'>EMPRESA <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='1' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(2)'>GRUPO <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='2' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(3)'>CONSULTOR <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='3' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(4)'>UNIDADE <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='4' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(5)'>CADASTRO <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='5' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(6)'>CNPJ <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='6' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(7)'>PROCURAÇÃO <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='7' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(8)'>ASSESSMENT <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='8' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(9)'>REUNIÃO TAX <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='9' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(10)'>REUNIÃO CORP <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='10' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(11)'>CHECKLIST <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='11' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(12)'>FINALIZADOS <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='12' oninput='window.applyFilters()'>
            </div>
          </th>
          <th>
            <div class='th-header-cell'>
              <div class='th-title' onclick='window.sortTable(13)'>STATUS <span>↕</span></div>
              <input type='text' class='th-search' placeholder='Filtrar...' data-col='13' oninput='window.applyFilters()'>
            </div>
          </th>
        </tr>
      </thead>
      <tbody id='tableBody'>
"

VAR _RowsHTML = 
    CONCATENATEX(
        _TabelaBase,
        VAR _Job = 'vw_powerbi_empresas_Onboarding'[JOB]
        VAR _Empresa = 'vw_powerbi_empresas_Onboarding'[EMPRESA]
        VAR _Grupo = IF(ISBLANK('vw_powerbi_empresas_Onboarding'[Grupo]), "-", 'vw_powerbi_empresas_Onboarding'[Grupo])
        VAR _Consultor = IF(ISBLANK('vw_powerbi_empresas_Onboarding'[CONSULTOR]), "-", 'vw_powerbi_empresas_Onboarding'[CONSULTOR])
        VAR _Unidade = IF(ISBLANK('vw_powerbi_empresas_Onboarding'[UNIDADE]), "-", FORMAT('vw_powerbi_empresas_Onboarding'[UNIDADE], "0"))
        VAR _Cadastro = IF(ISBLANK('vw_powerbi_empresas_Onboarding'[DATA_CADASTRO]), "-", FORMAT('vw_powerbi_empresas_Onboarding'[DATA_CADASTRO], "DD/MM/YYYY"))
        VAR _CNPJ = IF(ISBLANK('vw_powerbi_empresas_Onboarding'[CNPJ]), "-", 'vw_powerbi_empresas_Onboarding'[CNPJ])
        VAR _Proc = UPPER(TRIM('vw_powerbi_empresas_Onboarding'[PROCURACAO]))
        VAR _Ass = UPPER(TRIM('vw_powerbi_empresas_Onboarding'[ASSESSEMENT]))
        VAR _Checklist = IF(ISBLANK('vw_powerbi_empresas_Onboarding'[CHECKLIST]), "-", FORMAT('vw_powerbi_empresas_Onboarding'[CHECKLIST], "DD/MM/YYYY"))
        VAR _Status = 'vw_powerbi_empresas_Onboarding'[STATUS_SLA_TEXTO]
        
        VAR _IsCompleto = (_Proc = "SIM" && _Ass = "SIM" && NOT(ISBLANK('vw_powerbi_empresas_Onboarding'[CHECKLIST])))
        
        RETURN
            "<tr class='data-row' data-status='" & IF(CONTAINSSTRING(_Status, "Dentro"), "ontime", IF(CONTAINSSTRING(_Status, "Atrasou"), "delayed", "other")) & "' data-complete='" & IF(_IsCompleto, "1", "0") & "'>" &
                "<td><span class='badge-job'>" & _Job & "</span></td>" &
                "<td class='font-bold' title='" & _Empresa & "'>" & _Empresa & "</td>" &
                "<td>" & _Grupo & "</td>" &
                "<td>" & _Consultor & "</td>" &
                "<td><span class='badge-pill'>" & _Unidade & "</span></td>" &
                "<td>" & _Cadastro & "</td>" &
                "<td class='font-mono'>" & _CNPJ & "</td>" &
                "<td>" & IF(_Proc = "SIM", "<span class='badge b-green'>SIM</span>", "<span class='badge b-red'>NÃO</span>") & "</td>" &
                "<td>" & IF(_Ass = "SIM", "<span class='badge b-green'>SIM</span>", "<span class='badge b-red'>NÃO</span>") & "</td>" &
                "<td><span class='badge b-gray'>-</span></td>" &
                "<td><span class='badge b-gray'>-</span></td>" &
                "<td>" & IF(_Checklist = "-", "<span class='badge b-gray'>Pendente</span>", "<span class='badge b-blue'>" & _Checklist & "</span>") & "</td>" &
                "<td>" & IF(_IsCompleto, "<span class='badge b-complete'>✔ COMPLETO</span>", "<span class='badge b-progress'>EM ANDAMENTO</span>") & "</td>" &
                "<td>" & 
                    IF(
                        CONTAINSSTRING(_Status, "Dentro"),
                        "<span class='badge b-ontime'>● No Prazo</span>",
                        IF(
                            CONTAINSSTRING(_Status, "Atrasou"),
                            "<span class='badge b-delayed'>● Atrasado</span>",
                            "<span class='badge b-gray'>● " & IF(ISBLANK(_Status), "Pendente", _Status) & "</span>"
                        )
                    ) & 
                "</td>" &
            "</tr>",
        ""
    )

VAR _FooterHTML = "
      </tbody>
    </table>
  </div>

  <!-- PAGINATION BAR -->
  <div class='pagination-bar'>
    <div class='pg-info' id='pageInfo'>Página 1 de 1</div>
    <div class='pagination-controls'>
      <button class='pg-btn' id='btnPrev' onclick='window.prevPage()'>◀ Anterior</button>
      <button class='pg-btn' id='btnNext' onclick='window.nextPage()'>Próximo ▶</button>
    </div>
  </div>
</div>
"

VAR _JSScript = "
<script>
(function() {
  var allRows = [];
  var filteredRows = [];
  var currentPage = 1;
  var pageSize = 25;
  var sortCol = -1;
  var sortAsc = true;

  function init() {
    var tbody = document.getElementById('tableBody');
    if (!tbody) return;
    allRows = Array.from(tbody.querySelectorAll('tr.data-row'));
    filteredRows = allRows.slice();
    applyFilters();
  }

  window.applyFilters = function() {
    var globalVal = (document.getElementById('globalSearch') ? document.getElementById('globalSearch').value : '').toLowerCase().trim();
    var thInputs = Array.from(document.querySelectorAll('.th-search'));
    
    var colFilters = thInputs.map(function(inp) {
      return { col: parseInt(inp.getAttribute('data-col')), val: inp.value.toLowerCase().trim() };
    }).filter(function(f) { return f.val.length > 0; });

    filteredRows = allRows.filter(function(row) {
      var textAll = row.textContent.toLowerCase();
      if (globalVal && textAll.indexOf(globalVal) === -1) return false;

      var cells = row.querySelectorAll('td');
      for (var i = 0; i < colFilters.length; i++) {
        var cf = colFilters[i];
        if (cells[cf.col]) {
          var cellText = cells[cf.col].textContent.toLowerCase();
          if (cellText.indexOf(cf.val) === -1) return false;
        }
      }
      return true;
    });

    currentPage = 1;
    updateKPIs();
    renderPage();
  };

  window.resetFilters = function() {
    if (document.getElementById('globalSearch')) document.getElementById('globalSearch').value = '';
    document.querySelectorAll('.th-search').forEach(function(inp) { inp.value = ''; });
    applyFilters();
  };

  window.changePageSize = function(val) {
    pageSize = parseInt(val);
    currentPage = 1;
    renderPage();
  };

  window.prevPage = function() {
    if (currentPage > 1) {
      currentPage--;
      renderPage();
    }
  };

  window.nextPage = function() {
    var maxPage = pageSize === -1 ? 1 : Math.ceil(filteredRows.length / pageSize);
    if (currentPage < maxPage) {
      currentPage++;
      renderPage();
    }
  };

  window.sortTable = function(colIndex) {
    if (sortCol === colIndex) {
      sortAsc = !sortAsc;
    } else {
      sortCol = colIndex;
      sortAsc = true;
    }

    filteredRows.sort(function(a, b) {
      var cellA = a.querySelectorAll('td')[colIndex] ? a.querySelectorAll('td')[colIndex].textContent.trim() : '';
      var cellB = b.querySelectorAll('td')[colIndex] ? b.querySelectorAll('td')[colIndex].textContent.trim() : '';
      
      var numA = parseFloat(cellA.replace(/[^0-9.-]+/g, ''));
      var numB = parseFloat(cellB.replace(/[^0-9.-]+/g, ''));

      if (!isNaN(numA) && !isNaN(numB) && cellA.indexOf('/') === -1) {
        return sortAsc ? numA - numB : numB - numA;
      }
      return sortAsc ? cellA.localeCompare(cellB) : cellB.localeCompare(cellA);
    });

    renderPage();
  };

  function updateKPIs() {
    var total = filteredRows.length;
    var complete = 0, ontime = 0, delayed = 0;

    filteredRows.forEach(function(r) {
      if (r.getAttribute('data-complete') === '1') complete++;
      var st = r.getAttribute('data-status');
      if (st === 'ontime') ontime++;
      else if (st === 'delayed') delayed++;
    });

    if (document.getElementById('kpiTotal')) document.getElementById('kpiTotal').textContent = total;
    if (document.getElementById('kpiComplete')) document.getElementById('kpiComplete').textContent = complete;
    if (document.getElementById('kpiOnTime')) document.getElementById('kpiOnTime').textContent = ontime;
    if (document.getElementById('kpiDelayed')) document.getElementById('kpiDelayed').textContent = delayed;
    if (document.getElementById('visibleCount')) document.getElementById('visibleCount').textContent = total;
    if (document.getElementById('totalCount')) document.getElementById('totalCount').textContent = allRows.length;
  }

  function renderPage() {
    var tbody = document.getElementById('tableBody');
    if (!tbody) return;

    allRows.forEach(function(r) { r.style.display = 'none'; });

    var totalItems = filteredRows.length;
    var maxPages = (pageSize === -1 || totalItems === 0) ? 1 : Math.ceil(totalItems / pageSize);
    if (currentPage > maxPages) currentPage = maxPages;
    if (currentPage < 1) currentPage = 1;

    var start = (pageSize === -1) ? 0 : (currentPage - 1) * pageSize;
    var end = (pageSize === -1) ? totalItems : Math.min(start + pageSize, totalItems);

    for (var i = start; i < end; i++) {
      if (filteredRows[i]) {
        filteredRows[i].style.display = '';
      }
    }

    if (document.getElementById('pageInfo')) {
      document.getElementById('pageInfo').textContent = 'Página ' + currentPage + ' de ' + maxPages + ' (' + totalItems + ' registros)';
    }
    if (document.getElementById('btnPrev')) document.getElementById('btnPrev').disabled = (currentPage <= 1);
    if (document.getElementById('btnNext')) document.getElementById('btnNext').disabled = (currentPage >= maxPages);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    setTimeout(init, 50);
  }
})();
</script>
"

