
VAR _mesAtual = FORMAT(TODAY(), "yyyy-MM")

VAR _css = "<style> 
:root { --bg:#0b0f19; --card:rgba(18,24,38,0.6); --border:rgba(255,255,255,0.08); --accent:#e2b35a; --accent-glow:rgba(226,179,90,0.15); --text-main:#f1f5f9; --text-sec:#94a3b8; --row-hover:rgba(226,179,90,0.05); --font:'Inter','Segoe UI',system-ui,sans-serif; } 
html, body { margin:0; padding:0; width:100vw; height:100vh; background:var(--bg); font-family:var(--font); color:var(--text-main); overflow:hidden; } 
* { box-sizing:border-box; } 
.painel { background:radial-gradient(circle at top left,rgba(226,179,90,0.05),transparent 50%),var(--bg); border:1px solid var(--border); border-radius:16px; padding:24px; display:flex; flex-direction:column; height:calc(100vh - 20px); margin:10px; box-shadow:0 8px 40px rgba(0,0,0,0.55); } 
.cabecalho { display:flex; justify-content:space-between; align-items:center; margin-bottom:15px; flex-shrink:0; border-bottom:1px solid var(--border); padding-bottom:15px; } 
.cabecalho-esquerda { display:flex; align-items:center; gap:16px; }
.btn-voltar { display:flex; align-items:center; gap:6px; background:var(--card); color:var(--text-sec); border:1px solid var(--border); padding:8px 16px; border-radius:8px; cursor:pointer; font-weight:600; font-family:var(--font); transition:all 0.2s; text-transform:uppercase; font-size:11px; letter-spacing:1px; }
.btn-voltar:hover { background:rgba(239,68,68,0.1); border-color:#ef4444; color:#ef4444; }
.btn-copiar { display:flex; align-items:center; gap:6px; background:var(--card); color:var(--text-sec); border:1px solid var(--border); padding:8px 16px; border-radius:8px; cursor:pointer; font-weight:600; font-family:var(--font); transition:all 0.2s; text-transform:uppercase; font-size:11px; letter-spacing:1px; white-space:nowrap; }
.btn-copiar:hover { background:rgba(226,179,90,0.1); border-color:var(--accent); color:#fff; box-shadow:0 0 10px var(--accent-glow); }

.titulo { font-size:20px; font-weight:300; color:var(--text-main); letter-spacing:1px; text-transform:uppercase; display:flex; align-items:center; gap:10px;} 
.titulo span { font-weight:700; color:var(--accent); }
.controles { display:flex; align-items:center; gap:12px; }
.busca-global { background:rgba(0,0,0,0.3); border:1px solid var(--border); border-radius:8px; color:var(--text-main); font-family:var(--font); font-size:12px; padding:10px 16px; outline:none; transition:all 0.3s; } 
.busca-global:focus { border-color:var(--accent); background:rgba(0,0,0,0.5); } 
.table-wrapper { flex:1 1 auto; overflow-y:auto; padding-right:8px; position:relative; } 
.table-wrapper::-webkit-scrollbar { width:6px; } 
.table-wrapper::-webkit-scrollbar-track { background:transparent; } 
.table-wrapper::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.1); border-radius:4px; } 
.tabela { width:100%; border-collapse:collapse; text-align:left; } 
.tabela th { font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:1px; color:var(--text-sec); padding:12px 14px; background:rgba(11,15,25,0.95); backdrop-filter:blur(10px); border-bottom:1px solid var(--border); position:sticky; top:0; z-index:5; } 
.tabela td { font-size:13px; padding:12px 14px; color:var(--text-main); border-bottom:1px solid transparent; border-top:1px solid transparent; transition:all 0.2s; white-space:nowrap; } 
.tabela tr:hover td { background:var(--row-hover); border-color:var(--border); } 
.tabela tr:hover td:first-child { border-left:3px solid var(--accent); padding-left:11px; color:var(--accent); } 
.col-filter { background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.05); border-radius:4px; color:var(--text-main); font-family:var(--font); font-size:10px; padding:6px 8px; width:100%; outline:none; margin-top:6px; font-weight:normal; box-sizing:border-box; transition:0.2s; color-scheme:dark; }
.col-filter:focus { border-color:var(--accent); background:rgba(0,0,0,0.5); }
.col-filter::placeholder { color:var(--text-sec); }
.count-destaque { font-size:16px; font-weight:900; color:#fff; background:rgba(226,179,90,0.1); padding:4px 10px; border-radius:6px; margin-left:8px; border:1px solid var(--accent); }
</style>"

VAR _js = "<script> 
function popularProdutos() {
    var sel = document.getElementById('buscaColProduto');
    var rows = document.querySelectorAll('.linha-detalhe');
    var prods = {};
    for(var i=0; i<rows.length; i++){
        var p = rows[i].querySelector('.td-produto').textContent.trim();
        if(p && !prods[p]) { prods[p] = true; }
    }
    var arr = Object.keys(prods).sort();
    for(var j=0; j<arr.length; j++){
        var opt = document.createElement('option');
        opt.value = arr[j].toLowerCase();
        opt.textContent = arr[j];
        sel.appendChild(opt);
    }
}
setTimeout(popularProdutos, 200);

function filtrarTabela(){ 
    var qG=document.getElementById('buscaGlobal').value.toLowerCase(); 
    var qR=document.getElementById('buscaColRegional').value.toLowerCase(); 
    var qA=document.getElementById('buscaColArea').value.toLowerCase().trim(); 
    var qC=document.getElementById('buscaColCliente').value.toLowerCase().trim(); 
    var qJ=document.getElementById('buscaColJob').value.toLowerCase().trim(); 
    var qP=document.getElementById('buscaColProduto').value.toLowerCase().trim(); 
    var qD=document.getElementById('buscaColData').value; 
    
    var rows=document.querySelectorAll('.linha-detalhe'); 
    var count=0; 
    for(var i=0;i<rows.length;i++){ 
        var tR=rows[i].querySelector('.td-regional').textContent.toLowerCase(); 
        var tA=rows[i].querySelector('.td-area').textContent.toLowerCase(); 
        var tC=rows[i].querySelector('.td-cliente').textContent.toLowerCase(); 
        var tJ=rows[i].querySelector('.td-job').textContent.toLowerCase(); 
        var tP=rows[i].querySelector('.td-produto').textContent.toLowerCase(); 
        var mes=rows[i].getAttribute('data-mes'); 
        
        var matchG=(qG==='' || tA.indexOf(qG)>-1 || tC.indexOf(qG)>-1 || tJ.indexOf(qG)>-1 || tP.indexOf(qG)>-1 || tR.indexOf(qG)>-1); 
        
        var matchR=(qR==='' || tR.indexOf(qR)>-1); 
        var matchA=(qA==='' || tA.indexOf(qA)>-1); 
        var matchC=(qC==='' || tC.indexOf(qC)>-1); 
        var matchJ=(qJ==='' || tJ.indexOf(qJ)>-1); 
        var matchP=(qP==='' || tP.indexOf(qP)>-1); 
        var matchD=(qD==='' || mes===qD); 
        
        if(matchG && matchR && matchA && matchC && matchJ && matchP && matchD){ 
            rows[i].style.display=''; 
            count++; 
        } else { 
            rows[i].style.display='none'; 
        } 
    } 
    document.getElementById('totalLinhasCount').textContent=count; 
} 
setTimeout(filtrarTabela, 300); 

function copiarTabela() {
    var btn = document.getElementById('btnCopiar');
    var originalText = btn.innerHTML;
    btn.innerHTML = '&#8982; Copiando...';
    var textToCopy = '';
    var ths = document.querySelectorAll('.tabela thead th');
    for(var i=0; i<ths.length; i++) {
        var span = ths[i].querySelector('span');
        var thText = span ? span.textContent.trim() : ths[i].textContent.trim();
        textToCopy += thText + (i === ths.length - 1 ? '\n' : '\t');
    }
    var rows = document.querySelectorAll('.linha-detalhe');
    for(var i=0; i<rows.length; i++) {
        if(rows[i].style.display !== 'none') {
            var tds = rows[i].querySelectorAll('td');
            for(var j=0; j<tds.length; j++) {
                textToCopy += tds[j].textContent.trim() + (j === tds.length - 1 ? '\n' : '\t');
            }
        }
    }
    var tempInput = document.createElement('textarea');
    tempInput.value = textToCopy;
    document.body.appendChild(tempInput);
    tempInput.select();
    try { document.execCommand('copy'); btn.innerHTML = '&#10004; Copiado!'; } 
    catch (err) { btn.innerHTML = '&#10060; Erro'; }
    document.body.removeChild(tempInput);
    setTimeout(function() { btn.innerHTML = originalText; }, 2000);
}
</script>"

VAR _linhas = 
    CONCATENATEX(
        FILTER(vw_powerbi_regionais_hono_encontrados, vw_powerbi_regionais_hono_encontrados[VALOR_FINAL] > 0),
        "<tr class='linha-detalhe' data-mes='" & FORMAT(vw_powerbi_regionais_hono_encontrados[DATA], "yyyy-MM") & "'>" & 
        "<td class='td-regional'>" & SWITCH(vw_powerbi_regionais_hono_encontrados[REGIONAL_DEFAULT], 1, "Regional Sul", 2, "Regional São Paulo", 3, "Regional Sudeste", 14, "Regional Norte/Nordeste/Centro Oeste", "Outros") & "</td>" & 
        "<td class='td-area'>" & vw_powerbi_regionais_hono_encontrados[AREA] & "</td>" & 
        "<td class='td-cliente'>" & LEFT(vw_powerbi_regionais_hono_encontrados[CLIENTE], 40) & "</td>" & 
        "<td class='td-job'>" & vw_powerbi_regionais_hono_encontrados[JOB] & "</td>" & 
        "<td class='td-produto'>" & vw_powerbi_regionais_hono_encontrados[PRODUTO] & "</td>" & 
        "<td class='td-data'>" & FORMAT(vw_powerbi_regionais_hono_encontrados[DATA], "dd/MM/yyyy") & "</td>" & 
        "<td class='td-valor' style='text-align:right; font-family:consolas,monospace; color:var(--accent); font-weight:700;'>" & FORMAT(vw_powerbi_regionais_hono_encontrados[VALOR_FINAL] + 0, "Currency") & "</td>" & 
        "</tr>",
        "",
        vw_powerbi_regionais_hono_encontrados[VALOR_FINAL], DESC
    )

VAR _html = 
    "<html><head><meta charset='UTF-8'>" & _css & "</head><body>" &
    "<div class='painel'>" &
        "<div class='cabecalho'>" &
            "<div class='cabecalho-esquerda'>" &
                "<button class='btn-voltar'>&#8592; Voltar</button>" &
                "<div class='titulo'>DETALHAMENTO <span>HONORÁRIOS ENCONTRADOS</span></div>" &
                "<div class='count-destaque' id='totalLinhasCount'>0</div>" &
            "</div>" &
            "<div class='controles'>" &
                "<input type='text' id='buscaGlobal' class='busca-global input-busca' placeholder='&#128269; Buscar em tudo...' onkeyup='filtrarTabela()'>" &
                "<button class='btn-copiar' id='btnCopiar' onclick='copiarTabela()'>&#128203; Copiar Linhas</button>" &
            "</div>" &
        "</div>" &
        "<div class='table-wrapper'>" &
            "<table class='tabela' id='tabelaDetalhe'>" &
                "<thead>" &
                    "<tr>" &
                        "<th><span>Regional</span><br><select id='buscaColRegional' class='col-filter' onchange='filtrarTabela()'><option value=''>Todas</option><option value='regional sul'>Regional Sul</option><option value='regional são paulo'>Regional SP</option><option value='regional sudeste'>Regional Sudeste</option><option value='regional norte/nordeste/centro oeste'>Regional N/NE/CO</option></select></th>" &
                        "<th><span>Área</span><br><input type='text' id='buscaColArea' class='col-filter' placeholder='Filtrar Área...' onkeyup='filtrarTabela()'></th>" &
                        "<th><span>Cliente</span><br><input type='text' id='buscaColCliente' class='col-filter' placeholder='Filtrar Cliente...' onkeyup='filtrarTabela()'></th>" &
                        "<th><span>Job</span><br><input type='text' id='buscaColJob' class='col-filter' placeholder='Filtrar Job...' onkeyup='filtrarTabela()'></th>" &
                        "<th><span>Produto</span><br><select id='buscaColProduto' class='col-filter' onchange='filtrarTabela()'><option value=''>Todos</option></select></th>" &
                        "<th><span>Data</span><br><input type='month' id='buscaColData' class='col-filter' onchange='filtrarTabela()' value='" & _mesAtual & "'></th>" &
                        "<th style='text-align:right;'><span>Valor Honorário</span><br><div style='height:26px;'></div></th>" &
                    "</tr>" &
                "</thead>" &
                "<tbody id='tbodyDetalhe'>" &
                    _linhas &
                "</tbody>" &
            "</table>" &
        "</div>" &
    "</div>" & _js & "</body></html>"

RETURN _html
